[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 9] = 8;
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 13] = SP;
SP = [PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 11] * 512 - 1;

R1=1;
call MOD_1;

alias child_pid R0;
alias curr_pid R1;
curr_pid=[SYSTEM_STATUS_TABLE+1];
alias pagetable R2;
pagetable=[PROCESS_TABLE+curr_pid*16+14];
alias userSP R3;
userSP=[PROCESS_TABLE+curr_pid*16+13];

if(child_pid==-1) then
[[pagetable+2*(userSP-1)/512]*512+((userSP-1)%512)]=-1;
[PROCESS_TABLE + (curr_pid * 16) + 9] = 0;
SP=userSP;
ireturn;
endif;

if([pagetable+4]==-1) then
multipush(R0,R1,R2,R3);
R1=1;
call MOD_2;
R4=R0;
multipop(R0,R1,R2,R3);
[pagetable+4]=R4;
[pagetable+5]="0100";
endif;

if([pagetable+6]==-1) then
multipush(R0,R1,R2,R3);
R1=1;
call MOD_2;
R4=R0;
multipop(R0,R1,R2,R3);
[pagetable+6]=R4;
[pagetable+7]="0100";
endif;

alias proc_table R5;
proc_table=PROCESS_TABLE+curr_pid*16;

alias child_table R6;
child_table=PROCESS_TABLE+child_pid*16;

[child_table+0]=0;
[child_table+1]=child_pid;
[child_table+2]=curr_pid;
[child_table+3]=[proc_table+3];
[child_table+4]=CREATED;
[child_table+6]=[proc_table+6];
[child_table+7]=[proc_table+7];
[child_table+9]=0;
[child_table+12]=0;
[child_table+13]=[proc_table+13];

alias child_pg_table R7;
child_pg_table=[child_table+14];

multipush(R1,R2,R3,R5,R6,R7);
R1=1;
call MOD_2;
R4=R0;
multipop(R1,R2,R3,R5,R6,R7);
[child_pg_table+16]=R4;
[child_pg_table+17]=[pagetable+17];

multipush(R1,R2,R3,R5,R6,R7);
R1=1;
call MOD_2;
R4=R0;
multipop(R1,R2,R3,R5,R6,R7);
[child_pg_table+18]=R4;
[child_pg_table+19]=[pagetable+19];

multipush(R1,R2,R3,R5,R6,R7);
R1=1;
call MOD_2;
R4=R0;
multipop(R1,R2,R3,R5,R6,R7);
[child_table+11]=R4;

alias i R4;
i=0;
while(i<8) do
[[child_table+11]*512+496+2*i]=[[proc_table+11]*512+496+2*i];
[[child_table+11]*512+496+2*i+1]=[[proc_table+11]*512+496+2*i+1];
if([[child_table+11]*512+496+2*i]==1) then
[SEMAPHORE_TABLE+[[child_table+11]*512+496+2*i+1]*4+1]=[SEMAPHORE_TABLE+[[child_table+11]*512+496+2*i+1]*4+1]+1;
endif;
i=i+1;
endwhile;

i=0;
while(i<10) do
  [DISK_MAP_TABLE + child_pid*10 + i] = [DISK_MAP_TABLE + curr_pid*10 + i];
  i = i + 1;
endwhile;

i=0;
while(i<16) do
 [child_pg_table + i] = [pagetable + i];
 if(i%2 == 0) then
   if([pagetable + i] != -1) then
     [MEMORY_FREE_LIST + [pagetable + i]] = [MEMORY_FREE_LIST + [pagetable + i]] + 1;
   endif;
 endif;
i = i + 1;
endwhile;

[[child_table + 11]*512 ] = BP;

i=0;
while(i<512) do
  [[child_pg_table + 16]*512 + i] = [[pagetable + 16]*512 + i];
  [[child_pg_table + 18]*512 + i] = [[pagetable + 18]*512 + i];
i=i+1;
endwhile;

[[pagetable + 2*(userSP-1)/512] *512 + ((userSP-1)%512)] = child_pid;
[[child_pg_table + 2*(userSP-1)/512] *512 + ((userSP-1)%512)] = 0;
[proc_table + 9] = 0;
SP = userSP;
ireturn;