[PTBR+15] = "0000";

//Stack
[PTBR+16] = 81;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

//Setting PID
[PROCESS_TABLE + 1] = 0;

//setting state 
[PROCESS_TABLE+4]=CREATED;

//User area page Number in PT
[PROCESS_TABLE + 11] = 82;

//UPTR for idle process
[PROCESS_TABLE+13]=8*512;

//KPTR for idle process
[PROCESS_TABLE+12]=0;

//PTBR and PTLR
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE;
[PROCESS_TABLE + 15] = 10;

//stack pointer for idle process
[81 * 512] = [69*512 + 1];

//PTBR for INIT
PTBR = PAGE_TABLE_BASE+20;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
