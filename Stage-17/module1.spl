alias functionNum R1;
alias currentPID R2;
if(functionNum==2) then
alias userareapg R3;
userareapg=[PROCESS_TABLE+currentPID*16+11];
multipush(R1,R2,R3);
R1=2;
R2=userareapg;
call MOD_2;
multipop(R1,R2,R3);
return ;
endif;
if(functionNum==3) then
multipush(R1,R2);
R1=4;
R2=currentPID;
call MOD_1;
R1=2;
R2=currentPID;
call MOD_1;
multipop(R1,R2);
[PROCESS_TABLE+currentPID*16+4]=TERMINATED;
return ;
endif;
if(functionNum==4) then
[PTBR+0]=-1;
[PTBR+1]="0000";
[PTBR+2]=-1;
[PTBR+3]="0000";

alias i R3;
i=2;
while(i<PTLR) do
if([PTBR+2*i]!=-1) then
multipush(R1,R2,R3);
R1=2;
R2=[PTBR+2*i];
call MOD_2;
[PTBR+2*i]=-1;
[PTBR+2*i+1]="0000";
multipop(R1,R2,R3);
endif;
i=i+1;
endwhile;
return;
endif;

