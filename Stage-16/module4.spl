alias functionNum R1;
alias currentPID R2;
//terminal write
if(functionNum==3) then
   multipush(R1,R2,R3);
   functionNum=8;
   currentPID = [SYSTEM_STATUS_TABLE+1];
   call MOD_0;
   multipop(R1,R2,R3);
   print R3;
   multipush(R1,R2,R3);
   functionNum=9;
   currentPID = [SYSTEM_STATUS_TABLE+1];
   call MOD_0;
   multipop(R1, R2, R3);
   endif;

//terminal read
if(functionNum==4) then
   multipush(R1,R2,R3);
   functionNum=8;
   currentPID = [SYSTEM_STATUS_TABLE+1];
   call MOD_0;
   multipop(R1,R2,R3);
   read;
   [PROCESS_TABLE+currentPID*16+4]=WAIT_TERMINAL;
   multipush(R1,R2,R3);
   call MOD_5;
   multipop(R1,R2,R3);
   alias wordaddr R4;
   wordaddr=[PAGE_TABLE_BASE + currentPID*20 + 2*R3/512]*512 + R3%512;
   [wordaddr]=[PROCESS_TABLE+currentPID*16+8];
endif;
return ;