//set mode flag
[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 9] = 7;

alias userSP R0;
userSP=SP;

//save SP in UPTR
[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 13] = userSP;

//assign SP
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11]*512-1;

//retrieve fd
alias physicalPageNum R1;
alias offset R2;
alias fileDescPhysicalAddr R3;
alias currentPID R7;
currentPID=[SYSTEM_STATUS_TABLE+1];
physicalPageNum = [PAGE_TABLE_BASE+currentPID*20 + 2 * ((userSP - 4)/ 512)];
offset = (userSP - 4) % 512;
fileDescPhysicalAddr = (physicalPageNum * 512) + offset;
alias fileDescriptor R4;
fileDescriptor=[fileDescPhysicalAddr];

if(fileDescriptor!=-1) then
   alias physicalAddrRetVal R5;
	physicalAddrRetVal = ([PAGE_TABLE_BASE+currentPID*20 + 2 * ((userSP - 1) / 512)] * 512) + ((userSP - 1) % 512);
	[physicalAddrRetVal] = -1;
else
   alias word R5;
    word = [[PAGE_TABLE_BASE+currentPID*20 + 2 * ((userSP - 3) / 512)] * 512 + ((userSP - 3) % 512)];
    //save regs context
    multipush(R0,R1,R2,R3,R4,R5,R6,R7);
    R1=4;
    R2=[SYSTEM_STATUS_TABLE+1];
    R3=word;
   //call device manager
   call MOD_4;
   //pop regs
    multipop(R0,R1,R2,R3,R4,R5,R6,R7);
    //set return value to 0
    alias physicalAddrRetVal R6;
    physicalAddrRetVal = ([PAGE_TABLE_BASE+currentPID*20 + 2 * ((userSP - 1) / 512)] * 512) + ((userSP - 1) % 512);
    [physicalAddrRetVal] = 0;
endif;

//restore SP
SP = userSP;

//Reset the MODE FLAG to 0
[PROCESS_TABLE + [SYSTEM_STATUS_TABLE + 1] * 16 + 9] = 0;

//return to user mode
ireturn;
