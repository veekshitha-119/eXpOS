int main()
{
    decl
        int a, b, temp, gcd;
    enddecl
    begin
        temp = exposcall("Read", -1, a);
        temp = exposcall("Read", -1, b);
        while (b != 0) do
            temp = a % b;
            a = b;
            b = temp;
        endwhile;

        gcd = a;
        temp = exposcall("Write", -2, gcd);
        return 0;
    end
}