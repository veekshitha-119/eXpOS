type
    student
    {
        str name;
        int marks;
    }
endtype
int main()
{
decl
	int  temp;
    student stu;
enddecl
begin
    temp = exposcall("Heapset");
    stu =  exposcall("Alloc", 2); 
    stu.name = "John";    
    stu.marks = 89;        
    exposcall("Write",-2,stu.name);
    exposcall("Write",-2,stu.marks);
    return 0;
end
}
