alias functionNum R1;
alias currentPID R2;
if(functionNum==2) then
alias userareapg R3;
userareapg=[PROCESS_TABLE+currentPID*16+11];
multipush(R1,R2,R3);
R1=2;
R2=userareapg;
call MOD_2;
multipop(R1,R2,R3);
return ;
endif;

if(functionNum==3) then
multipush(R1,R2);
R1=4;
R2=currentPID;
call MOD_1;
R1=2;
R2=currentPID;
call MOD_1;
multipop(R1,R2);
[PROCESS_TABLE+currentPID*16+4]=TERMINATED;
return ;
endif;

if(functionNum==4) then
[PTBR+0]=-1;
[PTBR+1]="0000";
[PTBR+2]=-1;
[PTBR+3]="0000";

alias i R3;
alias pageno R4;
i=1;
while(i<(PTLR-1)) do
pageno=[PTBR+2*i+2];
if(pageno!=-1) then
multipush(R1,R2,R3,R4);
R1=2;
R2=pageno;
call MOD_2;
multipop(R1,R2,R3,R4);
[PTBR+2*i+2]=-1;
[PTBR+2*i+1+2]="0000";
endif;
i=i+1;
endwhile;

i=2;
while(i<10) do
if([DISK_MAP_TABLE + currentPID*10 + i] != -1) then
		if(i<4 || i>7) then
			multipush(R1, R2,R3,R4);
			R1 = 4;
			R3 = currentPID;
			R2 = [DISK_MAP_TABLE + currentPID*10 + i];
			call MOD_2;
			multipop(R1, R2,R3,R4);
		endif;
		[DISK_MAP_TABLE + currentPID*10 + i] = -1;
	endif;
	i = i + 1;
endwhile;

return;
endif;

if(functionNum==1) then
alias pid R3;
pid=0;
while(pid<16) do
if([PROCESS_TABLE+pid*16+4]==TERMINATED) then
[PROCESS_TABLE+pid*16+4]=ALLOCATED;
[PROCESS_TABLE+pid*16+1]=pid;
[PROCESS_TABLE + pid*16 + 14] = PAGE_TABLE_BASE + 20*pid;
[PROCESS_TABLE + pid*16 + 15] = 10;
R0=pid;
return ;
endif;
pid=pid+1;
endwhile;
R0=-1;
return ;
endif;