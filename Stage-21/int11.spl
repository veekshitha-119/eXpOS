alias userSP R0;
alias currPID R1;
userSP=SP;
currPID=[SYSTEM_STATUS_TABLE+1];
alias syscall R2;
syscall=[[PAGE_TABLE_BASE+currPID*20 + 2 * ((userSP - 5)/ 512)]*512+((userSP - 5) % 512)];

[PROCESS_TABLE+currPID*16+9]=syscall;
//save SP in UPTR
[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 13] = userSP;

//assign SP
SP=[PROCESS_TABLE + ([SYSTEM_STATUS_TABLE + 1] * 16) + 11]*512-1;

if(syscall==13) then
alias pid R3;
pid=[[PAGE_TABLE_BASE+currPID*20+2*((userSP-4)/512)]+((userSP-4)%512)];
if(pid==currPID||[PROCESS_TABLE+pid*16+4]==TERMINATED||pid<1||pid>15) then
[[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = -1; 
		[PROCESS_TABLE+currPID*16 + 9] = 0;
		SP = [PROCESS_TABLE+currPID*16 + 13];
ireturn;
endif;
[PROCESS_TABLE+currPID*16+4]=WAIT_PROCESS;
[PROCESS_TABLE+currPID*16+5]=pid;
multipush(R0,R1,R2,R3);
call MOD_5;
multipop(R0,R1,R2,R3);
[[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = 0; 
		[PROCESS_TABLE+currPID*16 + 9] = 0;
		SP = [PROCESS_TABLE+currPID*16 + 13];
ireturn;
endif;

if(syscall==14) then
alias pid R3;
pid=1;
while(pid<16) do 
if(([PROCESS_TABLE+pid*16+4]==WAIT_PROCESS)&&([PROCESS_TABLE+pid*16+5]==currPID)) then
[PROCESS_TABLE+pid*16+4]=READY;
[PROCESS_TABLE + pid * 16 + 5] = -1;
endif;
pid=pid+1;
endwhile;
[[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = 0; 
		[PROCESS_TABLE+currPID*16 + 9] = 0;
		SP = [PROCESS_TABLE+currPID*16 + 13];
ireturn;
endif;

if(syscall==11) then
[[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = currPID; 
		[PROCESS_TABLE+currPID*16 + 9] = 0;
		SP = [PROCESS_TABLE+currPID*16 + 13];
ireturn;
endif;

if(syscall==12) then
[[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = [PROCESS_TABLE+currPID*16+2]; 
		[PROCESS_TABLE+currPID*16 + 9] = 0;
		SP = [PROCESS_TABLE+currPID*16 + 13];
ireturn;
endif;