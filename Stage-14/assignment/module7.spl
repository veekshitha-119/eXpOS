//library code
loadi(63,13);
loadi(64,14);

//INIT
loadi(65,7);
loadi(66,8);

//load process 3
loadi(83,69);

//load process 4
loadi(89,70);

//INT 10
loadi(22,35);
loadi(23,36);

//Exception Handler
loadi(2, 15);
loadi(3, 16);

//int 7
loadi(16,29);
loadi(17,30);

//timer interrupt routine
loadi(4, 17);
loadi(5, 18);

//module 5
loadi(50,63);
loadi(51,64);

//PT for INIT
PTBR = PAGE_TABLE_BASE+20;
PTLR=10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = 78;
[PTBR+5] = "0110";
[PTBR+6] = 79;
[PTBR+7] = "0110";

//Code
[PTBR+8] = 65;
[PTBR+9] = "0100";
[PTBR+10] = 66;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 76;
[PTBR+17] = "0110";
[PTBR+18] = 77;
[PTBR+19] = "0110";

//Setting PID
[PROCESS_TABLE + 17] = 1;

//Setting state 
[PROCESS_TABLE+20]=CREATED;

//User area page Number in PT
[PROCESS_TABLE + 27] = 80;

//UPTR for idle process
[PROCESS_TABLE+29]=8*512;

//KPTR for idle process
[PROCESS_TABLE+28]=0;

//PTBR and PTLR
[PROCESS_TABLE + 30] = PAGE_TABLE_BASE + 20;
[PROCESS_TABLE + 31] = 10;

//Stack Pointer
[76*512] = [65*512+1];

//for even process
//PT
PTBR = PAGE_TABLE_BASE+2*20;
PTLR=10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = 84;
[PTBR+5] = "0110";
[PTBR+6] = 85;
[PTBR+7] = "0110";

//Code
[PTBR+8] = 83;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 86;
[PTBR+17] = "0110";
[PTBR+18] = 87;
[PTBR+19] = "0110";

//Setting PID
[PROCESS_TABLE + 33] = 2;

//Setting state 
[PROCESS_TABLE+36]=CREATED;

//User area page Number in PT
[PROCESS_TABLE + 43] = 88;

//UPTR for idle process
[PROCESS_TABLE+45]=8*512;

//KPTR for idle process
[PROCESS_TABLE+44]=0;

//PTBR and PTLR
[PROCESS_TABLE + 46] = PAGE_TABLE_BASE + 40;
[PROCESS_TABLE + 47] = 10;

//Stack Pointer
[86*512] = [83*512+1];

//for primenumbers
//PT
PTBR = PAGE_TABLE_BASE+3*20;
PTLR=10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = 90;
[PTBR+5] = "0110";
[PTBR+6] = 91;
[PTBR+7] = "0110";

//Code
[PTBR+8] = 89;
[PTBR+9] = "0100";
[PTBR+10] = -1;
[PTBR+11] = "0000";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 92;
[PTBR+17] = "0110";
[PTBR+18] = 93;
[PTBR+19] = "0110";

//Setting PID
[PROCESS_TABLE + 33+16] = 3;

//Setting state 
[PROCESS_TABLE+36+16]=CREATED;

//User area page Number in PT
[PROCESS_TABLE + 43+16] = 94;

//UPTR for idle process
[PROCESS_TABLE+45+16]=8*512;

//KPTR 
[PROCESS_TABLE+44+16]=0;

//PTBR and PTLR
[PROCESS_TABLE + 46+16] = PAGE_TABLE_BASE + 60;
[PROCESS_TABLE + 47+16] = 10;

//Stack Pointer
[92*512] = [89*512+1];

// Remaining process table entries
alias i R0;
i = 4;
while (i < 16) do
    [PROCESS_TABLE + (i * 16) + 4] = TERMINATED;
    i = i + 1;
endwhile;

//return to kernel mode
return ;