//boot_module
loadi(54,67);
loadi(55,68);

//idle_process
loadi(69,11);
loadi(70,12);

//set up stack for boot_module
SP = 82 * 512 - 1;

call BOOT_MODULE;

//Page Table 
PTBR = PAGE_TABLE_BASE;
PTLR = 10;

//Library
[PTBR+0] = 63;
[PTBR+1] = "0100";
[PTBR+2] = 64;
[PTBR+3] = "0100";

//Heap
[PTBR+4] = -1;
[PTBR+5] = "0000";
[PTBR+6] = -1;
[PTBR+7] = "0000";

//Code
[PTBR+8] = 69;
[PTBR+9] = "0100";
[PTBR+10] = 70;
[PTBR+11] = "0100";
[PTBR+12] = -1;
[PTBR+13] = "0000";
[PTBR+14] = -1;
[PTBR+15] = "0000";

//Stack
[PTBR+16] = 81;
[PTBR+17] = "0110";
[PTBR+18] = -1;
[PTBR+19] = "0000";

//Setting PID
[PROCESS_TABLE + 1] = 0;

//UPTR for idle process
[PROCESS_TABLE+13]=8*512;

//KPTR for idle process
[PROCESS_TABLE+12]=0;

//PTBR and PTLR
[PROCESS_TABLE + 14] = PAGE_TABLE_BASE;
[PROCESS_TABLE + 15] = 10;

//User area page Number in PT
[PROCESS_TABLE + 11] = 82;

//setting state 
[PROCESS_TABLE+4]=RUNNING;

// set curr pid in system Table
[SYSTEM_STATUS_TABLE + 1] = 0;

//stack pointer for idle process
[81 * 512] = [69*512 + 1];
SP = 8*512;

//Return
ireturn;